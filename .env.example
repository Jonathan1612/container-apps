# ============================================================
# CONFIGURACIÓN PRINCIPAL — copia este archivo a .env
# ============================================================

# Dominio principal del servidor (ej: miservidor.com)
DOMAIN=tudominio.com

# Email para certificados Let's Encrypt (OBLIGATORIO)
ACME_EMAIL=tu-email@ejemplo.com

# Basic Auth para el Dashboard de Traefik
# Generar con: echo $(htpasswd -nb admin TU_PASSWORD) | sed -e s/\\$/\\$\\$/g
# Ejemplo resultado: admin:$$apr1$$xxxxxxxx$$yyyyyyyyyyy
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$changeme$$changeme

# ============================================================
# GITHUB ACTIONS — configurar como Secrets en el repositorio
# ============================================================
# DO_HOST=IP_DE_TU_DROPLET
# DO_USER=root
# DO_SSH_KEY=<contenido de tu clave privada SSH>
# DO_PORT=22
